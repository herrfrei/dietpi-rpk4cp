#!/bin/bash

set -Eeuo pipefail

trap 'echo >&2 "ERROR: Script failed at line ${LINENO}"' ERR

#
# DietPi device tree overlay installation utility
# Based on armbian-add-overlay
#

BOOT_DIR="${BOOT_DIR:-/boot}"
ENV_FILE="${BOOT_DIR}/dietpiEnv.txt"

# Validate arguments before touching anything
if [[ $# -ne 2 ]]; then
    echo >&2 "Usage: $0 <key_name> <overlay_name>"
    echo >&2 "   eg: $0 user_overlays rk3399-dwc3-0-peripheral"
    exit 1
fi

KEY_NAME="$1"
OVERLAY_NAME="$2"

# Backup after validation
cp "${ENV_FILE}" "${ENV_FILE}.bak"

# Escape overlay name for safe use in sed patterns
OVERLAY_ESCAPED=$(printf '%s\n' "${OVERLAY_NAME}" | sed 's/[[\.*^$()+?{|]/\\&/g')

if grep -q "^${KEY_NAME}=" "${ENV_FILE}"; then
    line="$(grep "^${KEY_NAME}=" "${ENV_FILE}" | cut -d'=' -f2)"
    if grep -qE "(^|[[:space:]])${OVERLAY_ESCAPED}([[:space:]]|$)" <<< "${line}"; then
        echo "Overlay ${OVERLAY_NAME} is already configured"
    elif grep -q "^${KEY_NAME}=[[:space:]]*$" "${ENV_FILE}"; then
        sed -i "s/^${KEY_NAME}=[[:space:]]*$/${KEY_NAME}=${OVERLAY_ESCAPED}/" "${ENV_FILE}"
        echo "Added ${OVERLAY_NAME} to ${KEY_NAME}"
    else
        sed -i "/^${KEY_NAME}=/ s/$/ ${OVERLAY_ESCAPED}/" "${ENV_FILE}"
        echo "Added ${OVERLAY_NAME} to ${KEY_NAME}"
    fi
else
    echo "${KEY_NAME}=${OVERLAY_NAME}" >> "${ENV_FILE}"
    echo "Created ${KEY_NAME} entry"
fi

echo "Overlay installation completed successfully"
echo "A reboot is required to apply the changes"